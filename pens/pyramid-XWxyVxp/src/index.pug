.scene
    .object
        - var size = 5
        - var level = 0
        - var index = 0;
        while level < size
            - level++
            - var item = 0;
            - var itemsPerLevel = level * level;
            while item < itemsPerLevel
                - index++
                - item++
                .pyramid
                    .front(index=index)
                    .back
                    .left
                    .right
                    .bottom
